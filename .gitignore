.env
.env.*
node_modules/
# www/ is pre-built and committed so builds don't require a separate
# upstream web source checkout. Regenerate with: npm run prepare-www
# www/
*.apk
*.aab
web-app-source/
.replit-tmp/

.agents/skills/

# Local secrets & scratch files
.pat
.pat.b64
gate.log
*.log
.oldpat
release-keys.properties
android/app/release.keystore
*.jks

# Backup credentials + output. backup.sh reads .backup_env (keys for the project
# being backed up) and writes timestamped tarballs to backups/. Both contain
# production data or credentials and must never be committed.
.backup_env
backups/
*.tar.gz
*.tar.gz.sha256
